# ===== 复制本文件为 .env 后按需修改：cp .env.example .env =====

# WebUI 登录密码（务必修改！）
WEBUI_PASSWORD=admin123

# WebUI 监听端口（容器内端口；改了需同步改 compose 的 ports 映射）
TELE_PORT=8002

# 每日自动签到的小时（0-23），固定在该小时的第 5 分钟触发
TELE_SIGN_HOUR=0

# Telegram 推送
TELE_TOKEN=9250000000:AAErH5rN_XXXXXXXXXXk
TELE_CHAT_ID=891300000
# TELE_PROXY=http://127.0.0.1:7890        # TG 推送代理（服务器可直连 TG 就不填）

# TeleAgent 站点访问代理（一般不用填）
# TELEAGENT_PROXY=http://127.0.0.1:7890

# TeleAgent 客户端版本号伪装（一般不用改）
# TELEAGENT_APP_VERSION=2.7.1
